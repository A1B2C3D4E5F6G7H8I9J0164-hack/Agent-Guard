# AgentGuard Production & Local Environment Configuration
PROJECT_NAME="AgentGuard SOC"
ENVIRONMENT=production
SECRET_KEY=agentguard_super_secure_hmac_secret_key_change_me_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite local, PostgreSQL production)
SYNC_DATABASE_URL=sqlite:///./agentguard.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/agentguard

# Redis Pipeline & Cache URL
REDIS_URL=redis://localhost:6379/0

# Gateway & Hot Path Settings
HOT_PATH_FAIL_OPEN=false
GATEWAY_MAX_BATCH_SIZE=50
GATEWAY_FLUSH_INTERVAL_MS=250

# Frontend Next.js Public Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth Client ID (public)
GOOGLE_CLIENT_ID=811313813214-gnjq668frmm80tp8nrrhkme2qvs6l5dk.apps.googleusercontent.com

